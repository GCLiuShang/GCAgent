<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GCAgent.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#05060A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenIconBackgroundColor">#05060A</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.GCAgent.Main</item>
    </style>

    <style name="Theme.GCAgent.Main" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
